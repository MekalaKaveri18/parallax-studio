# Supabase → Project → Connect → "Session pooler" URI (IPv4-compatible; works on Vercel).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Random 32+ byte secret for signing sessions: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public URL of the deployed site (optional locally), e.g. https://parallax.vercel.app
BETTER_AUTH_URL=
